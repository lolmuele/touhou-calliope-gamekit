ND_SpriteKind\" id=\"STD5oD1k*:3(.[1V[ag*\">Enemy</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"*^w,I+@s~;G:7]i9gaR/\">hitbox</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"spritescreate\"><value name=\"img\"><shadow type=\"screen_image_picker\"><field name=\"img\">assets.image`hitbox`</field><data>{\"commentRefs\":[],\"fieldData\":{\"img\":\"myImages.image1\"}}</data></shadow></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value></block></value><next><block type=\"device_while\"><value name=\"COND\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow></value><statement name=\"DO\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"game.onUpdate(function onUpdate() {\" line1=\"        controller.moveSprite(hitbox)\" line2=\"    })\" numlines=\"3\"></mutation></block></statement></block></next></block></statement></block></xml>","main.ts":"","README.md":" ","assets.json":"","main.py":"class HUD:\n    def __init__(self):\n        self.background = sprites.create(assets.image(\"hudBackground\"), 999)\n        self.background.z = 999\n        self.background.set_position(140, 60)\n        self.stageBackground = sprites.create(assets.image(\"stageBackground\"), 999)\n        self.stageBackground.z = -100\n        self.stageBackground.set_position(60, 60)\n        pass\n\n#add enemies\n    #need to make pathing work -kinda implemented\n    #shots can't home yet -they can now\n    #need HP\n    #handle destruction -works but ugly\n\n#add bosses\n#add health/damage handling\n#add bombs\n#add hud functionality\n#visuals (ugh)\n#add menu\n#add drops\n\nclass Projectile:\n\n    def __init__(self, spriteName = \"projectile\", spriteKind = 1, xVel = 0, yVel = 0, maxSpeed = 50):\n        if spriteName == \"projectile\":\n            self.sprite = sprites.create(assets.tile(\"projectile\"), 1)\n            self.sprite.set_kind(spriteKind)\n        self.xVel = xVel\n        self.yVel = yVel\n        self.maxSpeed = maxSpeed\n\n    def homeTo(self, x, y):\n        diffX = x - self.sprite.x\n        diffY = y - self.sprite.y\n\n        if abs(diffX) >= abs(diffY):\n            self.xVel = self.maxSpeed * diffX/abs(diffX)\n            self.yVel = self.xVel * (diffY/diffX)\n        else:\n            self.yVel = self.maxSpeed * diffY/abs(diffY)\n            self.xVel = self.yVel * (diffX/diffY)\n\n        self.sprite.set_velocity(self.xVel, self.yVel)\n    \n    def setAngle(self, angle):\n        if angle < 0:\n            angle += 360\n        rad = angle * Math.PI / 180\n\n        self.xVel = Math.sin(rad) * self.maxSpeed\n        self.yVel = Math.cos(rad) * self.maxSpeed\n\n        self.sprite.set_velocity(self.xVel, self.yVel)\n\nclass playerProjectile(Projectile):\n    \n    def __init__(self):\n        super().__init__(spriteName = \"marisaShot\", maxSpeed = 200, spriteKind = 2)\n        self.sprite = sprites.create(assets.tile(\"marisaShot\"), 2)\n        self.sprite.set_scale(0.8, ScaleAnchor.MIDDLE)\n\nclass redCircleProjectile(Projectile):\n    def __init__(self):\n            super().__init__(spriteName = \"redBall\", maxSpeed = 30, spriteKind = 2)\n            self.sprite = sprites.create(assets.tile(\"redBall\"), 3)\n            self.sprite.set_scale(0.8, ScaleAnchor.MIDDLE)\n\n\nclass Enemy:\n    def __init__(self, spriteName: str, player: Player):\n        if spriteName == \"test\":\n            self.sprite = sprites.create(assets.tile(\"marisa\"), 4)\n        self.projectiles: List[Projectile] = []\n        #route format:\n        #[[x: int, y: int, maxSpeed:int, waitTime:int(in ms), shoot: bool], [x, y...]]\n        #self.route = []\n        #testroute here:\n        self.route = [[60, -10, 30, 500, 1], [60, 25, 30, 2000, 1], [12, 30, 300, 800, 1], [78, 90, 90, 0, 1], [0, 0, 50, 0, 1]]\n        self.sprite.set_position(self.route[0][0], self.route[0][1])\n        self.routePoint = 1\n        self.waitTime = 0\n        self.player: Player = player\n    \n    def shoot(self):\n\n        self.projectiles.append(redCircleProjectile())\n        self.projectiles[len(self.projectiles)-1].sprite.set_position(self.sprite.x, self.sprite.y)\n        self.projectiles[len(self.projectiles)-1].setAngle(0)\n\n    def shootHoming(self):\n\n        self.projectiles.append(redCircleProjectile())\n        self.projectiles[len(self.projectiles)-1].sprite.set_position(self.sprite.x, self.sprite.y)\n        self.projectiles[len(self.projectiles)-1].homeTo(self.player.sprite.x, self.player.sprite.y)\n\n\n    def homeTo(self, x, y):\n\n        diffX = x - self.sprite.x\n        diffY = y - self.sprite.y\n\n        if abs(diffX) >= abs(diffY):\n            self.xVel = self.maxSpeed * diffX/abs(diffX)\n            self.yVel = self.xVel * (diffY/diffX)\n        else:\n            self.yVel = self.maxSpeed * diffY/abs(diffY)\n            self.xVel = self.yVel * (diffX/diffY)\n\n        self.sprite.set_velocity(self.xVel, self.yVel)\n    \n    def closeEnough(self, x1, x2, y1, y2, speed):\n\n        tolerance = speed // 50 if speed // 50 > 2 else 2\n        diffX = abs(x1 - x2)\n        diffY = abs(y1 - y2)\n        \n        if diffX <= tolerance and diffY <= tolerance:\n            print(str(diffX)+ \" \" + str(diffY)+ \" \" + str(speed // 4))\n            return True\n        else:\n            return False\n\n    def goRoute(self):\n\n        if self.waitTime > 0:\n            self.waitTime -= game.runtime() - self.pointReachedTime\n\n        elif self.routePoint == len(self.route):\n            pass\n\n        elif self.closeEnough(self.sprite.x, self.route[self.routePoint][0], self.sprite.y, self.route[self.routePoint][1], self.route[self.routePoint][2]):\n            self.pointReachedTime = game.runtime()\n            self.waitTime = self.route[self.routePoint][3]\n            if self.waitTime > 0:\n                self.sprite.set_velocity(0, 0)\n            self.routePoint += 1\n        \n        elif self.route[self.routePoint][4]:\n            self.shootHoming()\n            self.route[self.routePoint][4] = 0\n\n        if not self.routePoint == len(self.route) and self.waitTime <= 0:\n            self.maxSpeed = self.route[self.routePoint][2]\n            self.homeTo(self.route[self.routePoint][0], self.route[self.routePoint][1])\n\n        \n\nclass Player:\n    def __init__(self):\n        self.sprite = sprites.create(assets.tile(\"\"\"hitbox\"\"\"), SpriteKind.player)\n        self.sprite.set_stay_in_screen(True)\n        self.sprite.set_kind(0)\n        self.level = 0\n        self.projectiles = []\n        self.slowDownVariable = 0\n        self.skin = sprites.create(assets.tile(\"\"\"marisa\"\"\"))\n        self.skin.follow(self.sprite)\n    def movementController(self):\n\n        xVel = 0\n        yVel = 0\n\n        if controller.up.is_pressed():\n            yVel -= 80\n            \n        if controller.down.is_pressed():\n            yVel += 80\n\n        if controller.left.is_pressed():\n            xVel -= 80\n\n        if controller.right.is_pressed():\n            xVel += 80\n\n        if controller.B.is_pressed():\n            xVel = int(xVel / 2)\n            yVel = int(yVel / 2)\n\n        self.sprite.set_velocity(xVel, yVel)\n\n    def shoot(self):\n        if self.slowDownVariable == 2:\n\n            if self.level == 0:\n                self.projectiles.append(playerProjectile())\n                self.projectiles[len(self.projectiles)-1].sprite.set_position(self.sprite.x, self.sprite.y-8)\n                self.projectiles[len(self.projectiles)-1].setAngle(180)\n                self.slowDownVariable = 0\n\n            if self.level == 1:\n                self.projectiles.append(playerProjectile())\n                self.projectiles[len(self.projectiles)-1].sprite.set_position(self.sprite.x, self.sprite.y-8)\n                self.projectiles[len(self.projectiles)-1].setAngle(180)\n                self.slowDownVariable = 0\n        else:\n            self.slowDownVariable += 1\n           \ni = 0\n\nclass Game:\n    def __init__(self):\n        self.hud = HUD()\n        self.player = Player()\n        self.projectiles: List[Projectile] = []\n        self.enemies: List[Enemy] = [Enemy(\"test\", self.player)]\n        \n        \n\n    def collisionHandler(self):\n        #print(\"collided!\")\n        pass\n\n    def collisionCheck(self):\n        #spritekinds:\n        #0 = player\n        #1 = test projectile\n        #2 = player projectile\n        #3 = enemy projectile\n        #4 = enemy\n        #999 = hud\n        def onOverlap():\n            self.collisionHandler()\n\n        sprites.on_overlap(0, 1, onOverlap)\n\n    def frametimes(self):\n        self.frametimes += game.runtime\n        self.prevRunTime = game.runtime()\n\n    \n    def projectileTest(self):\n        global i\n        \n        if i % 5 == 0:\n            self.projectiles.append(Projectile(spriteName = \"projectile\"))\n            #self.projectiles.homeTo(self.player.sprite.x, self.player.sprite.y)\n            for g in range(len(self.projectiles)):\n                curO: Projectile = self.projectiles[g]\n                self.projectiles[len(self.projectiles)-1].setAngle(i)\n                if i >= 360: i = 0 \n            \n        i = i+1\n\n    def projectileDestructor(self):\n        width = scene.screen_width()\n        height = scene.screen_height()\n        #test projectiles\n        if len(self.projectiles) > 0:\n            for i in range(len(self.projectiles)):\n                curO: Projectile = self.projectiles[i]\n                if curO.sprite.x < 0 or curO.sprite.x > width -15 or curO.sprite.y < 0 or curO.sprite.y > height:\n                    sprites.destroy(curO.sprite)\n                    self.projectiles.remove_at(i)\n                    i -= 1\n        #player projectiles\n        if len(self.player.projectiles) > 0:\n            for i in range(len(self.player.projectiles)):\n                cur1: Projectile = self.player.projectiles[i]\n                if cur1.sprite.x < 0 or cur1.sprite.x > width - 15 or cur1.sprite.y < 0 or cur1.sprite.y > height:\n                    sprites.destroy(cur1.sprite)\n                    self.player.projectiles.remove_at(i)\n                    i -= 1\n        #enemy projectiles\n        if len(self.enemies) > 0:\n            for g in self.enemies:\n                for i in range(len(g.projectiles)):\n                    cur2: Projectile = g.projectiles[i]\n                    if cur2.sprite.x < 0 or cur2.sprite.x > width - 15 or cur2.sprite.y < 0 or cur2.sprite.y > height:\n                        sprites.destroy(cur2.sprite)\n                        g.projectiles.remove_at(i)\n                        i -= 1\n        #enemies\n        if len(self.enemies) > 0:\n            i = 0\n            for enemy in self.enemies:\n                cur3: Enemy = enemy\n                if cur3.sprite.x < -15 or cur3.sprite.x > width - 15 or cur3.sprite.y < -15 or cur3.sprite.y > height + 15:\n                    if len(cur3.projectiles) == 0:\n                        sprites.destroy(cur3.sprite)\n                        self.enemies.remove_at(i)\n                        i -= 1\n                i += 1\n\n    def waves(self):\n        pass\n\n    def enemyActions(self):\n        for obj in self.enemies:\n            obj.goRoute()\n\n\n    def mainLoop(self):\n        self.prevRuntime = 0\n        self.collisionCheck()\n        def onUpdate():\n            #print(\"frametime: \" + str(game.runtime() - self.prevRunTime))\n            self.projectileTest()\n            self.player.movementController()\n            self.projectileDestructor()\n            self.player.shoot()\n            if self.player.sprite.x > 115: self.player.sprite.set_position(115, self.player.sprite.y)\n            self.enemyActions()\n            \n            \n        game.on_update(onUpdate)\n\n    \n\n\ngameObj = Game()\ngameObj.mainLoop()","tilemap.g.jres":"{\n    \"tile1\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAgAgAAAAAAACIiAAAAAAAAIiIAAAAAAAAgAgAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"hitbox\"\n    },\n    \"tile2\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAKoAAAAAAAAAqgoAAAAAoKqqqgAAAACgqqqqAAAAAAAAqgoAAAAAAACqAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"projectile\"\n    },\n    \"tile3\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAwkwkAAAAAMJOZAAAAAACTmQkAAAAAMJGZAAAAAAAwkZkAAAAAAAATkQkAAAAAADATmQAAAAAAADCTCQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"marisaShot\"\n    },\n    \"tile4\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAABgAAAA8AAAAPYAAAD//wAA9hABEf//DwD/EBER//8PYP8VERH//wD2/1UV8f/xAP//VVURH/8F//9VVRHx/1Xw/1VVER//BQD/VRHx//EPAP8QERH//w8A/xAREf//BgD/EAER9mYAAPAAAABmAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"marisa\"\n    },\n    \"tile5\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAiIgAAAAAAIgAAIgAAAAACIAIgAAAAIAAiIgACAAAgICIiAgIAACAgIiICAgAAIAAiIgACAAAAAiACIAAAAAAiAAAiAAAAAAAiIgAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"redBall\"\n    },\n    \"tile6\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA